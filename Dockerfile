FROM node:22-alpine
RUN apk add --no-cache ffmpeg git
WORKDIR /app
RUN printf '%s' '' >> /tmp/b.b64
RUN printf '%s' '' >> /tmp/b.b64
RUN printf '%s' '' >> /tmp/b.b64
RUN printf '%s' '' >> /tmp/b.b64
RUN printf '%s' '' >> /tmp/b.b64
RUN printf '%s' '' >> /tmp/b.b64
RUN printf '%s' '' >> /tmp/b.b64
RUN base64 -d /tmp/b.b64 | tar xz -C /app && rm /tmp/b.b64
RUN npm install --omit=dev
ENV NODE_ENV=production
EXPOSE 3000
CMD ["node", "src/index.js"]
